{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "noUncheckedIndexedAccess": true,
    "types": ["bun"],
    "paths": {
      "#iam/*": ["./src/*"],
      "@klnap/payload-iam": ["./src/exports/index.ts"],
      "@klnap/payload-iam/client": ["./src/exports/client.ts"],
      "@klnap/payload-iam/rsc": ["./src/exports/rsc.ts"],
      "@klnap/payload-iam/next": ["./src/exports/next.ts"],
      "@payload-config": ["./src/types/payload-config.stub.ts"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
